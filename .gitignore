node_modules/

# 內部文件（QA 驗收規格等），不上傳
docs/excluded/
.backups/
.claude/settings.local.json
.DS_Store

# 自動化除錯 harness 輸出（screenshot 等）
.playwright-mcp/
# Page Rounds 視覺驗收截圖（在 docs/excluded/ 下，已被 docs/excluded/ 規則涵蓋）
# 舊 Playwright MCP 設定檔（目前已改用 tools/debug-harness.js 不再需要）
.playwright-mcp.json

# Claude Design 原始下載（HTML/zip/uploads），已抽取必要 source 至 store-assets/sources/
Claude design/

# Safari build artifacts（產出 .pkg）
# safari-app/safari-bootstrap.sh / safari-build.sh / export options plist / Xcode project 仍要 commit
# 中間檔 BUILD_DIR 已移到 $TMPDIR（避開 iCloud Drive 同步衝突），不再生在 safari-app/build/
# 此規則仍保留是因為 v0.7.138 release 流程踩坑時 safari-app/build/ 被產出過 + iCloud fileprovider
# 接管後成 root-owned，留著規則確保萬一未來改回本地路徑也不會誤 commit。
safari-app/build/
safari-app/*.pkg

# Xcode user-specific state
*.xcuserdata/
xcuserdata/

# Claude Code 本機 session 狀態（權限設定 / lock），不進 repo
.claude/
