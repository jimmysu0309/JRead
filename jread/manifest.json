{
  "manifest_version": 3,
  "name": "JRead",
  "version": "1.6.26",
  "description": "純閱讀模式：一鍵隱藏廣告、側邊欄、彈窗，以乾淨排版呈現主文",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jread@jimmy.zm.su"
    }
  },
  "action": {
    "default_title": "JRead",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/namespace.js",
        "content/home-launcher.js",
        "content/orion-detect.js",
        "content/keepalive.js",
        "content/settings-defaults.js",
        "content/domain-match.js",
        "content/link-follow.js",
        "content/shortcut-utils.js",
        "content/custom-shortcuts.js",
        "content/touch-gestures.js",
        "content/toast.js",
        "content/floating-icon.js",
        "content/cinema-mode.js",
        "content/youtube-borderless.js",
        "content/x-thread.js",
        "content/fb-post.js",
        "content/detector.js",
        "content/cleaner.js",
        "content/edit-mode.js",
        "content/styler.js",
        "content/space-scroll.js",
        "content/paged-mode.js",
        "content/position-memory.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/orion-detect.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-reader-mode": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "切換純閱讀模式"
    },
    "send-to-readwise": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "送到儲存服務（Readwise / Instapaper，必要時自動啟動閱讀模式）"
    },
    "toggle-youtube-borderless": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Alt+Y"
      },
      "description": "切換 YouTube 無邊模式"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "popup/popup.html",
        "reader/reader.html",
        "reader/article.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
